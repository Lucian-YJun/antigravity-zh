{
  "name": "antigravity-zh",
  "version": "1.1.1",
  "description": "Antigravity 中文汉化补丁 (Next-Gen) - 同帧无闪烁渲染版",
  "main": "scripts/cli.js",
  "bin": "scripts/patch.js",
  "pkg": {
    "assets": [
      "src/**/*"
    ]
  },
  "scripts": {
    "build": "pkg . -t node18-win-x64 -o dist/Antigravity-zh-patch.exe",
    "patch": "node scripts/patch.js",
    "repatch": "node scripts/patch.js --close --relaunch",
    "unpatch": "node scripts/patch.js --revert",
    "sync": "node scripts/sync-dict.js",
    "test:main": "node tests/test-main.js",
    "test:page": "node tests/test-page.js"
  },
  "keywords": [
    "antigravity",
    "localization",
    "chinese"
  ],
  "author": "",
  "license": "MIT",
  "directories": {
    "test": "tests"
  },
  "type": "commonjs",
  "dependencies": {
    "asar": "^3.2.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "pkg": "^5.8.1"
  }
}
